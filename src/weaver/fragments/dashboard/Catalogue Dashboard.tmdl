model Model

/// Every measure of the Catalogue Dashboard.
///
/// The catalogue tables are generated for the catalogues the Dashboard reads,
/// one set per catalogue over Direct Lake or one partition per catalogue in
/// Import. A measure reads a table through the CATALOGUES macro, given the
/// table, optional WHERE filters joined by &&, and named columns: it returns
/// every catalogue's rows with "@catalogue", the catalogue's label, and
/// "@code", its position in this payload, before the named columns. The
/// SUM_CATALOGUES macro adds one scalar expression per catalogue. __SCOPE__ declares the items the page shows:
/// _scoped is false on a page that shows the whole estate; otherwise
/// _chosenkeys holds the items picked in 'Dashboard item', or its first item.
///
/// The Data measures return delimited text for the renderer: each table starts
/// with U+E003 and its name and column names, each row with U+E002, and
/// U+E001 separates fields. An item, node key or record ID ends with U+E004
/// and its catalogue's code. Times are milliseconds since 1970 UTC. The page
/// measures replace every < with U+E000, so no catalogue text can close the
/// script element that carries the data. A measure's text cannot exceed 2^21
/// characters, so a page carries only the data it draws and refuses more.
table 'Dashboard measures'
    annotation 'Weaver.MeasureTable' = true

    /// Load subjects whose last load Failed, raised an Error or was Blocked.
    measure 'Failed loads' = SUM_CATALOGUES('Load status', CALCULATE(COUNTROWS('Load status'), 'Load status'[Result] IN {"Failed", "Error", "Blocked"})) + 0
        formatString: #,##0
        displayFolder: Health

    /// Load subjects whose last load completed with rejected rows.
    measure 'Rejected loads' = SUM_CATALOGUES('Load status', CALCULATE(COUNTROWS('Load status'), 'Load status'[Result] = "Rejected")) + 0
        formatString: #,##0
        displayFolder: Health

    /// Load subjects rebuilt and not loaded since.
    measure 'Pending loads' = SUM_CATALOGUES('Load status', CALCULATE(COUNTROWS('Load status'), 'Load status'[Result] = "Pending")) + 0
        formatString: #,##0
        displayFolder: Health

    /// Tests and Assumptions whose last run Failed, raised an Error or was Blocked.
    measure 'Failed tests' = SUM_CATALOGUES('Test status', CALCULATE(COUNTROWS('Test status'), 'Test status'[Result] IN {"Failed", "Error", "Blocked"})) + 0
        formatString: #,##0
        displayFolder: Health

    /// When the latest load or test was processed, in UTC.
    measure 'Latest processed completion' = ```
        MAX(
            MAXX(CATALOGUES('Load status' WHERE 'Load status'[Result] <> "Pending", "@completed", 'Load status'[Completed datetime]), [@completed]),
            MAXX(CATALOGUES('Test status' WHERE 'Test status'[Result] <> "Pending", "@completed", 'Test status'[Completed datetime]), [@completed])
        )
        ```
        formatString: yyyy-mm-dd hh:nn:ss
        displayFolder: Health

    /// When the model answered, in UTC.
    measure 'Observed at' = UTCNOW()
        formatString: yyyy-mm-dd hh:nn:ss
        displayFolder: Health

    /// Installed logical items, each catalogue and the Dashboard aside.
    measure 'Items' = ```
        COUNTROWS(DISTINCT(SELECTCOLUMNS(
            CATALOGUES('Lineage node' WHERE NOT 'Lineage node'[Is internal], "@item", 'Lineage node'[Item label]),
            "@catalogue", [@catalogue],
            "@item", [@item]
        ))) + 0
        ```
        formatString: #,##0
        displayFolder: Estate

    /// Installed graph nodes, each catalogue and the Dashboard aside.
    measure 'Installed objects' = SUM_CATALOGUES('Lineage node', CALCULATE(COUNTROWS('Lineage node'), NOT 'Lineage node'[Is internal])) + 0
        formatString: #,##0
        displayFolder: Estate

    /// Processed Log records.
    measure 'Processed log records' = SUM_CATALOGUES('Log', COUNTROWS('Log')) + 0
        formatString: #,##0
        displayFolder: Estate

    /// The query instant, the catalogues read, their installations, the items
    /// the page shows and how many installed items 'Dashboard item' lacks.
    measure 'Catalogue data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        VAR _now = UTCNOW()
        __SCOPE__
        VAR _items = CATALOGUES(
            'Installation',
            "@item", 'Installation'[Item type] & "/" & 'Installation'[Item name],
            "@workspace", 'Installation'[Workspace name],
            "@workspaceid", 'Installation'[Workspace GUID],
            "@target", 'Installation'[Target name],
            "@targetid", 'Installation'[Target item GUID],
            "@version", 'Installation'[Weaver version]
        )
        VAR _listed = SELECTCOLUMNS(ALL('Dashboard item'), "@catalogue", 'Dashboard item'[Catalogue], "@item", 'Dashboard item'[Item key])
        VAR _unlisted = EXCEPT(
            SELECTCOLUMNS(FILTER(_items, [@item] <> "Warehouse/_weaver" && LEFT([@item], 7) <> "Report/"), "@catalogue", [@catalogue], "@item", [@item]),
            _listed
        )
        RETURN
            _t & "meta" & _f & "at" & _f & "format" & _f & "mode" & _f & "scoped" & _f & "unlisted" & _f & "imported"
            & _r & FORMAT((_now - DATE(1970, 1, 1)) * 86400000, "0") & _f & "2" & _f & "{mode}" & _f & IF(_scoped, "1") & _f & COUNTROWS(_unlisted)
            & _f & "{imported}"
            & _t & "catalogues" & _f & "code" & _f & "label" & _f & "reference"
            & "{catalogues}"
            & _t & "items" & _f & "item" & _f & "workspace" & _f & "target" & _f & "version" & _f & "workspaceid" & _f & "targetid"
            & CONCATENATEX(
                _items,
                _r & [@item] & _q & [@code]
                    & _f & [@workspace]
                    & _f & [@target]
                    & _f & [@version]
                    & _f & [@workspaceid]
                    & _f & [@targetid],
                ""
            )
            & _t & "scope" & _f & "item" & _f & "picked"
            & IF(_scoped, CONCATENATEX(_chosen, _r & [@si] & _q & [@scode] & _f & IF(_picked, "1"), ""))
        ```
        displayFolder: Data

    /// Installed nodes and edges, the catalogues and the Dashboard aside, and
    /// the physical shortcuts that may land in another catalogue. An edge names
    /// its upstream when it reads outside Weaver, or when no lineage node is
    /// that upstream. Descriptions are kept for the items the page shows.
    measure 'Lineage data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        __SCOPE__
        VAR _all = CATALOGUES(
            'Lineage node',
            "@key", 'Lineage node'[Node key],
            "@item", 'Lineage node'[Item label],
            "@schema", 'Lineage node'[Schema name],
            "@object", 'Lineage node'[Object name],
            "@kind", 'Lineage node'[Node kind],
            "@label", 'Lineage node'[Label],
            "@flags", IF('Lineage node'[Can load], 1, 0) + IF('Lineage node'[Is static], 2, 0) + IF('Lineage node'[Is mirrored], 4, 0) + IF('Lineage node'[Is installed], 8, 0),
            "@internal", 'Lineage node'[Is internal],
            "@description", LEFT('Lineage node'[Description], 400)
        )
        VAR _nodes = FILTER(_all, NOT [@internal])
        VAR _keys = SELECTCOLUMNS(_nodes, "@c", [@catalogue], "@k", [@key])
        VAR _known = SELECTCOLUMNS(_all, "@c", [@catalogue], "@k", [@key])
        VAR _edges = FILTER(
            CATALOGUES(
                'Lineage edge',
                "@down", 'Lineage edge'[Downstream node key],
                "@up", 'Lineage edge'[Upstream node key],
                "@kind", 'Lineage edge'[Edge kind],
                "@through", 'Lineage edge'[Through node key],
                "@upid", 'Lineage edge'[Upstream node ID]
            ),
            ([@catalogue], [@down]) IN _keys
        )
        VAR _internal = EXCEPT(
            DISTINCT(SELECTCOLUMNS(FILTER(_all, [@internal]), "@code", [@code], "@item", [@item])),
            DISTINCT(SELECTCOLUMNS(_nodes, "@code", [@code], "@item", [@item]))
        )
        VAR _shortcuts = CATALOGUES(
            'Shortcut' WHERE 'Shortcut'[Target type] = "Physical" && 'Shortcut'[Schema name] <> "_" && 'Shortcut'[Schema name] <> "Tables/_",
            "@item", 'Shortcut'[Item type] & "/" & 'Shortcut'[Item name],
            "@schema", 'Shortcut'[Schema name],
            "@object", 'Shortcut'[Object name],
            "@type", 'Shortcut'[Shortcut type],
            "@workspace", 'Shortcut'[Target workspace name],
            "@targettype", 'Shortcut'[Target item type],
            "@target", 'Shortcut'[Target item name],
            "@targetschema", 'Shortcut'[Target schema name],
            "@targetobject", 'Shortcut'[Target object name]
        )
        RETURN
            _t & "nodes" & _f & "key" & _f & "item" & _f & "schema" & _f & "object" & _f & "kind" & _f & "label" & _f & "flags" & _f & "description"
            & CONCATENATEX(
                _nodes,
                _r & [@key] & _q & [@code]
                    & _f & [@item] & _q & [@code]
                    & _f & [@schema]
                    & _f & [@object]
                    & _f & [@kind]
                    & _f & [@label]
                    & _f & [@flags]
                    & _f & IF(NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys, [@description]),
                ""
            )
            & _t & "edges" & _f & "down" & _f & "up" & _f & "kind" & _f & "through" & _f & "reference"
            & CONCATENATEX(
                _edges,
                _r & [@down] & _q & [@code]
                    & _f & [@up] & _q & [@code]
                    & _f & LEFT([@kind], 1)
                    & _f & IF(NOT ISBLANK([@through]), [@through] & _q & [@code])
                    & _f & IF([@kind] = "External" || NOT (([@catalogue], [@up]) IN _known), [@upid]),
                ""
            )
            & _t & "internal" & _f & "item"
            & CONCATENATEX(_internal, _r & [@item] & _q & [@code], "")
            & _t & "shortcuts" & _f & "item" & _f & "schema" & _f & "object" & _f & "type" & _f & "workspace" & _f & "targettype" & _f & "target" & _f & "targetschema" & _f & "targetobject"
            & CONCATENATEX(
                _shortcuts,
                _r & [@item] & _q & [@code]
                    & _f & [@schema] & _f & [@object] & _f & [@type]
                    & _f & [@workspace] & _f & [@targettype] & _f & [@target]
                    & _f & [@targetschema] & _f & [@targetobject],
                ""
            )
        ```
        displayFolder: Data

    /// Installed nodes only, without edges or descriptions: what a page that names
    /// objects needs to draw their marks and say what they are.
    measure 'Node data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        VAR _all = CATALOGUES(
            'Lineage node',
            "@key", 'Lineage node'[Node key],
            "@item", 'Lineage node'[Item label],
            "@schema", 'Lineage node'[Schema name],
            "@object", 'Lineage node'[Object name],
            "@kind", 'Lineage node'[Node kind],
            "@label", 'Lineage node'[Label],
            "@flags", IF('Lineage node'[Can load], 1, 0) + IF('Lineage node'[Is static], 2, 0) + IF('Lineage node'[Is mirrored], 4, 0) + IF('Lineage node'[Is installed], 8, 0),
            "@internal", 'Lineage node'[Is internal]
        )
        VAR _nodes = FILTER(_all, NOT [@internal])
        VAR _internal = EXCEPT(
            DISTINCT(SELECTCOLUMNS(FILTER(_all, [@internal]), "@code", [@code], "@item", [@item])),
            DISTINCT(SELECTCOLUMNS(_nodes, "@code", [@code], "@item", [@item]))
        )
        RETURN
            _t & "nodes" & _f & "key" & _f & "item" & _f & "schema" & _f & "object" & _f & "kind" & _f & "label" & _f & "flags"
            & CONCATENATEX(
                _nodes,
                _r & [@key] & _q & [@code]
                    & _f & [@item] & _q & [@code]
                    & _f & [@schema]
                    & _f & [@object]
                    & _f & [@kind]
                    & _f & [@label]
                    & _f & [@flags],
                ""
            )
            & _t & "internal" & _f & "item"
            & CONCATENATEX(_internal, _r & [@item] & _q & [@code], "")
        ```
        displayFolder: Data

    /// Current load and test outcomes, and when each data object was last built.
    measure 'Status data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        VAR _loads = CATALOGUES(
            'Load status',
            "@item", 'Load status'[Item type] & "/" & 'Load status'[Item name],
            "@schema", 'Load status'[Schema name],
            "@object", 'Load status'[Object name],
            "@result", 'Load status'[Result],
            "@completed", 'Load status'[Completed datetime],
            "@duration", 'Load status'[Duration milliseconds]
        )
        VAR _tests = CATALOGUES(
            'Test status',
            "@item", 'Test status'[Item type] & "/" & 'Test status'[Item name],
            "@schema", 'Test status'[Schema name],
            "@object", 'Test status'[Object name],
            "@result", 'Test status'[Result],
            "@completed", 'Test status'[Completed datetime],
            "@failures", 'Test status'[Failure count]
        )
        VAR _built = CATALOGUES(
            'Registry' WHERE 'Registry'[Object role] = "Data",
            "@item", 'Registry'[Item type] & "/" & 'Registry'[Item name],
            "@schema", 'Registry'[Schema name],
            "@object", 'Registry'[Object name],
            "@built", 'Registry'[Build datetime]
        )
        RETURN
            _t & "loads" & _f & "item" & _f & "schema" & _f & "object" & _f & "result" & _f & "completed" & _f & "duration"
            & CONCATENATEX(
                _loads,
                _r & [@item] & _q & [@code]
                    & _f & [@schema]
                    & _f & [@object]
                    & _f & [@result]
                    & _f & IF(ISBLANK([@completed]), "", FORMAT(([@completed] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & [@duration],
                ""
            )
            & _t & "tests" & _f & "item" & _f & "schema" & _f & "object" & _f & "result" & _f & "completed" & _f & "failures"
            & CONCATENATEX(
                _tests,
                _r & [@item] & _q & [@code]
                    & _f & [@schema]
                    & _f & [@object]
                    & _f & [@result]
                    & _f & IF(ISBLANK([@completed]), "", FORMAT(([@completed] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & [@failures],
                ""
            )
            & _t & "built" & _f & "item" & _f & "schema" & _f & "object" & _f & "built"
            & CONCATENATEX(
                _built,
                _r & [@item] & _q & [@code]
                    & _f & [@schema]
                    & _f & [@object]
                    & _f & IF(ISBLANK([@built]), "", FORMAT(([@built] - DATE(1970, 1, 1)) * 86400000, "0")),
                ""
            )
        ```
        displayFolder: Data

    /// Declared tables, views and folders that Registry does not certify.
    measure 'Build data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        VAR _declared = UNION(
            CATALOGUES('Table dictionary', "@item", 'Table dictionary'[Item type] & "/" & 'Table dictionary'[Item name], "@schema", 'Table dictionary'[Schema name], "@object", 'Table dictionary'[Object name]),
            CATALOGUES('Folder dictionary', "@item", 'Folder dictionary'[Item type] & "/" & 'Folder dictionary'[Item name], "@schema", 'Folder dictionary'[Schema name], "@object", 'Folder dictionary'[Object name])
        )
        VAR _missing = EXCEPT(
            _declared,
            CATALOGUES('Registry', "@item", 'Registry'[Item type] & "/" & 'Registry'[Item name], "@schema", 'Registry'[Schema name], "@object", 'Registry'[Object name])
        )
        RETURN
            _t & "uncertified" & _f & "item" & _f & "schema" & _f & "object"
            & CONCATENATEX(_missing, _r & [@item] & _q & [@code] & _f & [@schema] & _f & [@object], "")
        ```
        displayFolder: Data

    /// The 40 latest workflows of the last 7 days, each summarised over every
    /// record it processed in every catalogue, and how many the 7 days hold.
    measure 'Workflow data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _now = UTCNOW()
        VAR _ids = DISTINCT(SELECTCOLUMNS(CATALOGUES('Log' WHERE 'Log'[Completed datetime] >= _now - 7, "@workflow", 'Log'[Workflow ID]), "@workflow", [@workflow]))
        VAR _log = CATALOGUES(
            'Log' WHERE 'Log'[Workflow ID] IN _ids,
            "@workflow", 'Log'[Workflow ID],
            "@start", 'Log'[Started datetime],
            "@end", 'Log'[Completed datetime],
            "@failed", IF('Log'[Result] IN {"Failed", "Error", "Blocked"}, 1, 0),
            "@task", 'Log'[Task type]
        )
        VAR _all = GROUPBY(
            _log,
            [@workflow],
            "@first", MINX(CURRENTGROUP(), [@start]),
            "@last", MAXX(CURRENTGROUP(), [@end]),
            "@records", SUMX(CURRENTGROUP(), 1),
            "@failures", SUMX(CURRENTGROUP(), [@failed])
        )
        VAR _recent = TOPN(40, _all, [@last], DESC, [@workflow], ASC)
        VAR _tasks = DISTINCT(SELECTCOLUMNS(_log, "@w", [@workflow], "@task", [@task]))
        RETURN
            _t & "workflowcount" & _f & "count" & _r & COUNTROWS(_all)
            & _t & "workflows" & _f & "workflow" & _f & "started" & _f & "completed" & _f & "records" & _f & "failed" & _f & "tasks"
            & CONCATENATEX(
                _recent,
                VAR _w = [@workflow]
                RETURN
                    _r & _w
                        & _f & IF(ISBLANK([@first]), "", FORMAT(([@first] - DATE(1970, 1, 1)) * 86400000, "0"))
                        & _f & IF(ISBLANK([@last]), "", FORMAT(([@last] - DATE(1970, 1, 1)) * 86400000, "0"))
                        & _f & [@records]
                        & _f & [@failures]
                        & _f & CONCATENATEX(FILTER(_tasks, [@w] = _w), [@task], ",", [@task], ASC),
                "",
                [@last], DESC,
                [@workflow], ASC
            )
        ```
        displayFolder: Data

    /// The 300 latest workflows of the last 30 days with the span each task type
    /// of each occupied, the 200 longest object records of the 8 latest of them,
    /// each load of those runs with its own counts (the 200 longest per run), and
    /// the Tests' statistics per object over the last day, 7 days and 30 days.
    measure 'Run data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        VAR _now = UTCNOW()
        VAR _ids = DISTINCT(SELECTCOLUMNS(CATALOGUES('Log' WHERE 'Log'[Completed datetime] >= _now - 30, "@workflow", 'Log'[Workflow ID]), "@workflow", [@workflow]))
        VAR _log = CATALOGUES(
            'Log' WHERE 'Log'[Workflow ID] IN _ids,
            "@workflow", 'Log'[Workflow ID],
            "@task", 'Log'[Task type],
            "@start", 'Log'[Started datetime],
            "@end", 'Log'[Completed datetime],
            "@isobject", IF(ISBLANK('Log'[Object name]), 0, 1),
            "@failed", IF('Log'[Result] IN {"Failed", "Error", "Blocked"}, 1, 0)
        )
        VAR _all = GROUPBY(
            _log,
            [@workflow],
            "@first", MINX(CURRENTGROUP(), [@start]),
            "@last", MAXX(CURRENTGROUP(), [@end]),
            "@records", SUMX(CURRENTGROUP(), 1),
            "@objects", SUMX(CURRENTGROUP(), [@isobject]),
            "@failures", SUMX(CURRENTGROUP(), [@failed])
        )
        VAR _recent = TOPN(300, _all, [@last], DESC, [@workflow], ASC)
        VAR _recentids = SELECTCOLUMNS(_recent, "@workflow", [@workflow])
        VAR _spans = GROUPBY(
            FILTER(_log, [@workflow] IN _recentids),
            [@workflow],
            [@task],
            "@tstart", MINX(CURRENTGROUP(), [@start]),
            "@tend", MAXX(CURRENTGROUP(), [@end]),
            "@trecords", SUMX(CURRENTGROUP(), 1),
            "@tfailed", SUMX(CURRENTGROUP(), [@failed])
        )
        VAR _eight = SELECTCOLUMNS(TOPN(8, _recent, [@last], DESC, [@workflow], ASC), "@workflow", [@workflow])
        VAR _records = CATALOGUES(
            'Log' WHERE 'Log'[Workflow ID] IN _eight && NOT ISBLANK('Log'[Object name]),
            "@workflow", 'Log'[Workflow ID],
            "@sk", 'Log'[Log SK],
            "@task", 'Log'[Task type],
            "@targettype", 'Log'[Target type],
            "@target", 'Log'[Target name],
            "@schema", 'Log'[Schema name],
            "@object", 'Log'[Object name],
            "@result", 'Log'[Result],
            "@start", 'Log'[Started datetime],
            "@end", 'Log'[Completed datetime],
            "@duration", 'Log'[Duration milliseconds],
            "@message", IF('Log'[Result] <> "Succeeded", LEFT('Log'[Message], 160))
        )
        VAR _objects = GENERATE(
            _eight,
            VAR _o = [@workflow]
            RETURN SELECTCOLUMNS(
                TOPN(200, FILTER(_records, [@workflow] = _o), [@duration], DESC, [@code], ASC, [@sk], ASC),
                "@owner", [@workflow], "@ocode", [@code], "@osk", [@sk], "@otask", [@task], "@otargettype", [@targettype], "@otarget", [@target],
                "@oschema", [@schema], "@oobject", [@object], "@oresult", [@result], "@ostart", [@start], "@oend", [@end], "@oduration", [@duration], "@omessage", [@message]
            )
        )
        VAR _loads = CATALOGUES(
            'Load statistic' WHERE 'Load statistic'[Workflow ID] IN _eight,
            "@workflow", 'Load statistic'[Workflow ID],
            "@sk", 'Load statistic'[Load statistic SK],
            "@item", 'Load statistic'[Item type] & "/" & 'Load statistic'[Item name],
            "@schema", 'Load statistic'[Schema name],
            "@object", 'Load statistic'[Object name],
            "@start", 'Load statistic'[Started datetime],
            "@end", 'Load statistic'[Completed datetime],
            "@duration", 'Load statistic'[Duration milliseconds],
            "@read", 'Load statistic'[Rows read],
            "@inserted", 'Load statistic'[Rows inserted],
            "@updated", 'Load statistic'[Rows updated],
            "@deleted", 'Load statistic'[Rows deleted],
            "@rejected", 'Load statistic'[Rows rejected],
            "@reload", IF('Load statistic'[Is reload], "1"),
            "@skip", IF('Load statistic'[Is static skip], "1")
        )
        VAR _stats = GENERATE(
            _eight,
            VAR _o = [@workflow]
            RETURN SELECTCOLUMNS(
                TOPN(200, FILTER(_loads, [@workflow] = _o), [@duration], DESC, [@code], ASC, [@sk], ASC),
                "@owner", [@workflow], "@scode", [@code], "@sitem", [@item], "@sschema", [@schema], "@sobject", [@object], "@sstart", [@start], "@send", [@end],
                "@sduration", [@duration], "@sread", [@read], "@sinserted", [@inserted], "@supdated", [@updated], "@sdeleted", [@deleted], "@srejected", [@rejected],
                "@sreload", [@reload], "@sskip", [@skip]
            )
        )
        VAR _tests = CATALOGUES(
            'Log' WHERE 'Log'[Task type] = "test" && NOT ISBLANK('Log'[Object name]) && 'Log'[Completed datetime] >= _now - 30,
            "@targettype", 'Log'[Target type],
            "@target", 'Log'[Target name],
            "@schema", 'Log'[Schema name],
            "@object", 'Log'[Object name],
            "@end", 'Log'[Completed datetime],
            "@duration", 'Log'[Duration milliseconds],
            "@failed", IF('Log'[Result] IN {"Failed", "Error", "Blocked"}, 1, 0)
        )
        VAR _testheader = _f & "catalogue" & _f & "targettype" & _f & "target" & _f & "schema" & _f & "object" & _f & "runs" & _f & "duration" & _f & "longest" & _f & "failed" & _f & "last"
        RETURN
            _t & "runs" & _f & "workflow" & _f & "started" & _f & "completed" & _f & "records" & _f & "objects" & _f & "failed"
            & CONCATENATEX(
                _recent,
                _r & [@workflow]
                    & _f & IF(ISBLANK([@first]), "", FORMAT(([@first] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & IF(ISBLANK([@last]), "", FORMAT(([@last] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & [@records]
                    & _f & [@objects]
                    & _f & [@failures],
                "",
                [@last], DESC,
                [@workflow], ASC
            )
            & _t & "runtasks" & _f & "workflow" & _f & "task" & _f & "started" & _f & "completed" & _f & "records" & _f & "failed"
            & CONCATENATEX(
                _spans,
                _r & [@workflow]
                    & _f & [@task]
                    & _f & IF(ISBLANK([@tstart]), "", FORMAT(([@tstart] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & IF(ISBLANK([@tend]), "", FORMAT(([@tend] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & [@trecords]
                    & _f & [@tfailed],
                "",
                [@workflow], ASC,
                [@task], ASC
            )
            & _t & "runobjects" & _f & "workflow" & _f & "catalogue" & _f & "task" & _f & "targettype" & _f & "target" & _f & "schema" & _f & "object" & _f & "result" & _f & "started" & _f & "completed" & _f & "message"
            & CONCATENATEX(
                _objects,
                _r & [@owner]
                    & _f & [@ocode]
                    & _f & [@otask]
                    & _f & [@otargettype]
                    & _f & [@otarget]
                    & _f & [@oschema]
                    & _f & [@oobject]
                    & _f & [@oresult]
                    & _f & IF(ISBLANK([@ostart]), "", FORMAT(([@ostart] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & IF(ISBLANK([@oend]), "", FORMAT(([@oend] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & [@omessage],
                "",
                [@owner], ASC,
                [@oduration], DESC,
                [@ocode], ASC,
                [@osk], ASC
            )
            & _t & "runstats" & _f & "workflow" & _f & "item" & _f & "schema" & _f & "object" & _f & "started" & _f & "completed" & _f & "duration" & _f & "read" & _f & "inserted" & _f & "updated" & _f & "deleted" & _f & "rejected" & _f & "reload" & _f & "skip"
            & CONCATENATEX(
                _stats,
                _r & [@owner]
                    & _f & [@sitem] & _q & [@scode]
                    & _f & [@sschema]
                    & _f & [@sobject]
                    & _f & IF(ISBLANK([@sstart]), "", FORMAT(([@sstart] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & IF(ISBLANK([@send]), "", FORMAT(([@send] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & [@sduration]
                    & _f & [@sread] & _f & [@sinserted] & _f & [@supdated] & _f & [@sdeleted] & _f & [@srejected]
                    & _f & [@sreload] & _f & [@sskip],
                "",
                [@owner], ASC,
                [@sduration], DESC
            )
            & _t & "testday" & _testheader & TEST_SUMMARY(_tests, _now - 1)
            & _t & "testweek" & _testheader & TEST_SUMMARY(_tests, _now - 7)
            & _t & "testmonth" & _testheader & TEST_SUMMARY(_tests, _now - 30)
        ```
        displayFolder: Data

    /// Every Log record of the twelve latest workflows of the last 7 days, up to
    /// 9,000 records, newest workflow first. Each workflow says how many it holds and how many
    /// are included; a record names its workflow by that order. A message is
    /// kept for workflow records and for work that did not succeed.
    measure 'Log data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        VAR _budget = 9000
        VAR _now = UTCNOW()
        VAR _ids = DISTINCT(SELECTCOLUMNS(CATALOGUES('Log' WHERE 'Log'[Completed datetime] >= _now - 7, "@workflow", 'Log'[Workflow ID]), "@workflow", [@workflow]))
        VAR _all = GROUPBY(
            CATALOGUES('Log' WHERE 'Log'[Workflow ID] IN _ids, "@workflow", 'Log'[Workflow ID], "@end", 'Log'[Completed datetime]),
            [@workflow],
            "@last", MAXX(CURRENTGROUP(), [@end]),
            "@records", SUMX(CURRENTGROUP(), 1)
        )
        VAR _recent = TOPN(12, _all, [@last], DESC, [@workflow], ASC)
        VAR _placed = ADDCOLUMNS(
            _recent,
            "@before",
                VAR _e = [@last]
                VAR _w = [@workflow]
                RETURN SUMX(FILTER(_recent, [@last] > _e || ([@last] = _e && [@workflow] < _w)), [@records]) + 0,
            "@index",
                VAR _e = [@last]
                VAR _w = [@workflow]
                RETURN COUNTROWS(FILTER(_recent, [@last] > _e || ([@last] = _e && [@workflow] < _w))) + 1
        )
        VAR _taken = ADDCOLUMNS(_placed, "@taken", MAX(0, MIN([@records], _budget - [@before])))
        VAR _chosen = SELECTCOLUMNS(FILTER(_taken, [@taken] > 0), "@workflow", [@workflow])
        VAR _records = CATALOGUES(
            'Log' WHERE 'Log'[Workflow ID] IN _chosen,
            "@workflow", 'Log'[Workflow ID],
            "@sk", 'Log'[Log SK],
            "@task", 'Log'[Task type],
            "@targettype", 'Log'[Target type],
            "@target", 'Log'[Target name],
            "@schema", 'Log'[Schema name],
            "@object", 'Log'[Object name],
            "@result", 'Log'[Result],
            "@start", 'Log'[Started datetime],
            "@end", 'Log'[Completed datetime],
            "@duration", 'Log'[Duration milliseconds],
            "@message", IF(ISBLANK('Log'[Object name]) || 'Log'[Result] <> "Succeeded", LEFT('Log'[Message], 300))
        )
        VAR _rows = GENERATE(
            SELECTCOLUMNS(FILTER(_taken, [@taken] > 0), "@owner", [@workflow], "@k", [@taken], "@i", [@index]),
            VAR _w = [@owner]
            VAR _k = [@k]
            RETURN TOPN(_k, FILTER(_records, [@workflow] = _w), [@start], ASC, [@code], ASC, [@sk], ASC)
        )
        RETURN
            _t & "logflows" & _f & "index" & _f & "workflow" & _f & "records" & _f & "included"
            & CONCATENATEX(_taken, _r & [@index] & _f & [@workflow] & _f & [@records] & _f & [@taken], "")
            & _t & "log" & _f & "id" & _f & "flow" & _f & "catalogue" & _f & "task" & _f & "targettype" & _f & "target" & _f & "schema" & _f & "object" & _f & "result" & _f & "started" & _f & "completed" & _f & "duration" & _f & "message"
            & CONCATENATEX(
                _rows,
                _r & [@sk] & _q & [@code]
                    & _f & [@i]
                    & _f & [@code]
                    & _f & [@task]
                    & _f & [@targettype]
                    & _f & [@target]
                    & _f & [@schema]
                    & _f & [@object]
                    & _f & [@result]
                    & _f & IF(ISBLANK([@start]), "", FORMAT(([@start] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & IF(ISBLANK([@end]), "", FORMAT(([@end] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & [@duration]
                    & _f & [@message],
                ""
            )
        ```
        displayFolder: Data

    /// Load statistics: per object over the last day, 7 days and 30 days, and the
    /// 50 largest single loads of the last 7 days.
    measure 'Statistic data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        VAR _now = UTCNOW()
        VAR _loads = CATALOGUES(
            'Load statistic' WHERE 'Load statistic'[Completed datetime] >= _now - 30,
            "@sk", 'Load statistic'[Load statistic SK],
            "@workflow", 'Load statistic'[Workflow ID],
            "@item", 'Load statistic'[Item type] & "/" & 'Load statistic'[Item name],
            "@schema", 'Load statistic'[Schema name],
            "@object", 'Load statistic'[Object name],
            "@start", 'Load statistic'[Started datetime],
            "@end", 'Load statistic'[Completed datetime],
            "@duration", 'Load statistic'[Duration milliseconds],
            "@read", 'Load statistic'[Rows read],
            "@inserted", 'Load statistic'[Rows inserted],
            "@updated", 'Load statistic'[Rows updated],
            "@deleted", 'Load statistic'[Rows deleted],
            "@rejected", 'Load statistic'[Rows rejected],
            "@reload", IF('Load statistic'[Is reload], 1, 0),
            "@skip", IF('Load statistic'[Is static skip], 1, 0)
        )
        VAR _header = _f & "item" & _f & "schema" & _f & "object" & _f & "loads" & _f & "duration" & _f & "longest" & _f & "read" & _f & "inserted" & _f & "updated" & _f & "deleted" & _f & "rejected" & _f & "reloads" & _f & "skips" & _f & "timedread" & _f & "timedduration" & _f & "last"
        VAR _largest = TOPN(
            50,
            FILTER(_loads, [@end] >= _now - 7 && (NOT ISBLANK([@inserted]) || NOT ISBLANK([@updated]) || NOT ISBLANK([@deleted]))),
            [@inserted] + [@updated] + [@deleted], DESC,
            [@code], ASC,
            [@sk], ASC
        )
        VAR _single = _f & "id" & _f & "item" & _f & "schema" & _f & "object" & _f & "workflow" & _f & "started" & _f & "completed" & _f & "duration" & _f & "read" & _f & "inserted" & _f & "updated" & _f & "deleted" & _f & "rejected" & _f & "reload" & _f & "skip"
        RETURN
            _t & "perfday" & _header & LOAD_SUMMARY(_loads, _now - 1)
            & _t & "perfweek" & _header & LOAD_SUMMARY(_loads, _now - 7)
            & _t & "perfmonth" & _header & LOAD_SUMMARY(_loads, _now - 30)
            & _t & "largest" & _single
            & CONCATENATEX(
                _largest,
                _r & [@sk] & _q & [@code]
                    & _f & [@item] & _q & [@code] & _f & [@schema] & _f & [@object]
                    & _f & [@workflow]
                    & _f & IF(ISBLANK([@start]), "", FORMAT(([@start] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & IF(ISBLANK([@end]), "", FORMAT(([@end] - DATE(1970, 1, 1)) * 86400000, "0"))
                    & _f & [@duration]
                    & _f & [@read] & _f & [@inserted] & _f & [@updated] & _f & [@deleted] & _f & [@rejected]
                    & _f & IF([@reload] = 1, "1") & _f & IF([@skip] = 1, "1"),
                ""
            )
        ```
        displayFolder: Data

    /// Declared schemas, tables, views, folders, columns, keys, relationships and
    /// validations of the items the page shows.
    measure 'Metadata data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        __SCOPE__
        VAR _schemas = FILTER(
            CATALOGUES('Schema dictionary', "@item", 'Schema dictionary'[Item type] & "/" & 'Schema dictionary'[Item name], "@schema", 'Schema dictionary'[Schema name], "@description", LEFT('Schema dictionary'[Description], 1000)),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _tables = FILTER(
            CATALOGUES(
                'Table dictionary',
                "@item", 'Table dictionary'[Item type] & "/" & 'Table dictionary'[Item name],
                "@schema", 'Table dictionary'[Schema name],
                "@object", 'Table dictionary'[Object name],
                "@type", 'Table dictionary'[Object type],
                "@description", LEFT('Table dictionary'[Description], 1000),
                "@lineage", LEFT('Table dictionary'[Lineage], 1000),
                "@primarykey", 'Table dictionary'[Primary key],
                "@notnull", 'Table dictionary'[Not null columns],
                "@identity", 'Table dictionary'[Identity column],
                "@incremental", IF('Table dictionary'[Is incremental], "1"),
                "@static", IF('Table dictionary'[Is static], "1"),
                "@prohibit", IF('Table dictionary'[Prohibit rebuild], "1")
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _folders = FILTER(
            CATALOGUES(
                'Folder dictionary',
                "@item", 'Folder dictionary'[Item type] & "/" & 'Folder dictionary'[Item name],
                "@schema", 'Folder dictionary'[Schema name],
                "@object", 'Folder dictionary'[Object name],
                "@description", LEFT('Folder dictionary'[Description], 1000),
                "@lineage", LEFT('Folder dictionary'[Lineage], 1000),
                "@filekey", 'Folder dictionary'[File key],
                "@incremental", IF('Folder dictionary'[Is incremental], "1"),
                "@static", IF('Folder dictionary'[Is static], "1")
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _columns = FILTER(
            CATALOGUES(
                'Column dictionary',
                "@item", 'Column dictionary'[Item type] & "/" & 'Column dictionary'[Item name],
                "@schema", 'Column dictionary'[Schema name],
                "@object", 'Column dictionary'[Object name],
                "@column", 'Column dictionary'[Column name],
                "@description", LEFT('Column dictionary'[Description], 400),
                "@identity", IF('Column dictionary'[Is identity], "1")
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _keys = FILTER(
            CATALOGUES(
                'Key dictionary' WHERE 'Key dictionary'[Key type] <> "Primary key",
                "@item", 'Key dictionary'[Item type] & "/" & 'Key dictionary'[Item name],
                "@schema", 'Key dictionary'[Schema name],
                "@object", 'Key dictionary'[Object name],
                "@type", 'Key dictionary'[Key type],
                "@columns", 'Key dictionary'[Column set]
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _foreign = FILTER(
            CATALOGUES(
                'Foreign key dictionary',
                "@item", 'Foreign key dictionary'[Item type] & "/" & 'Foreign key dictionary'[Item name],
                "@schema", 'Foreign key dictionary'[Foreign schema name],
                "@object", 'Foreign key dictionary'[Foreign object name],
                "@columns", 'Foreign key dictionary'[Foreign column set],
                "@primaryitem", 'Foreign key dictionary'[Primary item type] & "/" & 'Foreign key dictionary'[Primary item name],
                "@primaryschema", 'Foreign key dictionary'[Primary schema name],
                "@primaryobject", 'Foreign key dictionary'[Primary object name],
                "@primarycolumns", 'Foreign key dictionary'[Primary column set]
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _validations = FILTER(
            CATALOGUES(
                'Test dictionary',
                "@item", 'Test dictionary'[Item type] & "/" & 'Test dictionary'[Item name],
                "@schema", 'Test dictionary'[Schema name],
                "@object", 'Test dictionary'[Object name],
                "@type", 'Test dictionary'[Test type],
                "@description", LEFT('Test dictionary'[Description], 1000),
                "@primarykey", 'Test dictionary'[Primary key]
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        RETURN
            _t & "schemas" & _f & "item" & _f & "schema" & _f & "description"
            & CONCATENATEX(_schemas, _r & [@item] & _q & [@code] & _f & [@schema] & _f & [@description], "")
            & _t & "tables" & _f & "item" & _f & "schema" & _f & "object" & _f & "type" & _f & "description" & _f & "lineage" & _f & "primarykey" & _f & "notnull" & _f & "identity" & _f & "incremental" & _f & "static" & _f & "prohibitrebuild"
            & CONCATENATEX(
                _tables,
                _r & [@item] & _q & [@code] & _f & [@schema] & _f & [@object]
                    & _f & [@type] & _f & [@description] & _f & [@lineage]
                    & _f & [@primarykey] & _f & [@notnull] & _f & [@identity]
                    & _f & [@incremental] & _f & [@static] & _f & [@prohibit],
                ""
            )
            & _t & "folders" & _f & "item" & _f & "schema" & _f & "object" & _f & "description" & _f & "lineage" & _f & "filekey" & _f & "incremental" & _f & "static"
            & CONCATENATEX(
                _folders,
                _r & [@item] & _q & [@code] & _f & [@schema] & _f & [@object]
                    & _f & [@description] & _f & [@lineage] & _f & [@filekey]
                    & _f & [@incremental] & _f & [@static],
                ""
            )
            & _t & "columns" & _f & "item" & _f & "schema" & _f & "object" & _f & "column" & _f & "description" & _f & "identity"
            & CONCATENATEX(
                _columns,
                _r & [@item] & _q & [@code] & _f & [@schema] & _f & [@object] & _f & [@column] & _f & [@description] & _f & [@identity],
                ""
            )
            & _t & "keys" & _f & "item" & _f & "schema" & _f & "object" & _f & "type" & _f & "columns"
            & CONCATENATEX(_keys, _r & [@item] & _q & [@code] & _f & [@schema] & _f & [@object] & _f & [@type] & _f & [@columns], "")
            & _t & "foreignkeys" & _f & "item" & _f & "schema" & _f & "object" & _f & "columns" & _f & "primaryitem" & _f & "primaryschema" & _f & "primaryobject" & _f & "primarycolumns"
            & CONCATENATEX(
                _foreign,
                _r & [@item] & _q & [@code] & _f & [@schema] & _f & [@object] & _f & [@columns]
                    & _f & [@primaryitem] & _q & [@code] & _f & [@primaryschema] & _f & [@primaryobject] & _f & [@primarycolumns],
                ""
            )
            & _t & "validations" & _f & "item" & _f & "schema" & _f & "object" & _f & "type" & _f & "description" & _f & "primarykey"
            & CONCATENATEX(
                _validations,
                _r & [@item] & _q & [@code] & _f & [@schema] & _f & [@object] & _f & [@type] & _f & [@description] & _f & [@primarykey],
                ""
            )
        ```
        displayFolder: Data

    /// The semantic models the page shows: tables in authored order, columns,
    /// measures, relationships and the managed sources each table reads.
    measure 'Semantic data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        __SCOPE__
        VAR _models = FILTER(
            CATALOGUES('Semantic model', "@item", 'Semantic model'[Item type] & "/" & 'Semantic model'[Item name], "@description", LEFT('Semantic model'[Description], 1000)),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _tables = FILTER(
            CATALOGUES(
                'Semantic model table',
                "@item", 'Semantic model table'[Item type] & "/" & 'Semantic model table'[Item name],
                "@table", 'Semantic model table'[Table name],
                "@ordinal", 'Semantic model table'[Table ordinal],
                "@description", LEFT('Semantic model table'[Description], 1000),
                "@mode", 'Semantic model table'[Source mode],
                "@access", 'Semantic model table'[Source access]
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _columns = FILTER(
            CATALOGUES(
                'Semantic model column',
                "@item", 'Semantic model column'[Item type] & "/" & 'Semantic model column'[Item name],
                "@table", 'Semantic model column'[Table name],
                "@column", 'Semantic model column'[Column name],
                "@description", LEFT('Semantic model column'[Description], 400),
                "@datatype", 'Semantic model column'[Data type],
                "@columntype", 'Semantic model column'[Column type],
                "@sourcecolumn", 'Semantic model column'[Source column],
                "@expression", LEFT('Semantic model column'[Expression], 400)
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _measures = FILTER(
            CATALOGUES(
                'Semantic model measure',
                "@item", 'Semantic model measure'[Item type] & "/" & 'Semantic model measure'[Item name],
                "@table", 'Semantic model measure'[Table name],
                "@measure", 'Semantic model measure'[Measure name],
                "@description", LEFT('Semantic model measure'[Description], 400),
                "@expression", LEFT('Semantic model measure'[Expression], 1000),
                "@format", LEFT('Semantic model measure'[Format string], 200)
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _relationships = FILTER(
            CATALOGUES(
                'Semantic model relationship',
                "@item", 'Semantic model relationship'[Item type] & "/" & 'Semantic model relationship'[Item name],
                "@name", 'Semantic model relationship'[Relationship name],
                "@fromtable", 'Semantic model relationship'[From table],
                "@fromcolumn", 'Semantic model relationship'[From column],
                "@totable", 'Semantic model relationship'[To table],
                "@tocolumn", 'Semantic model relationship'[To column],
                "@fromcardinality", 'Semantic model relationship'[From cardinality],
                "@tocardinality", 'Semantic model relationship'[To cardinality],
                "@crossfilter", 'Semantic model relationship'[Cross filtering behavior],
                "@active", IF(ISBLANK('Semantic model relationship'[Is active]), "", IF('Semantic model relationship'[Is active], "1", "0"))
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        VAR _sources = FILTER(
            CATALOGUES(
                'Dependency' WHERE 'Dependency'[Item type] = "SemanticModel",
                "@item", 'Dependency'[Item type] & "/" & 'Dependency'[Item name],
                "@table", 'Dependency'[Referencing object name],
                "@reference", 'Dependency'[Dependency reference],
                "@sourceitem", IF(NOT ISBLANK('Dependency'[Referenced item type]), 'Dependency'[Referenced item type] & "/" & 'Dependency'[Referenced item name]),
                "@sourceschema", 'Dependency'[Referenced schema name],
                "@sourceobject", 'Dependency'[Referenced object name]
            ),
            NOT _scoped || ([@catalogue], [@item]) IN _chosenkeys
        )
        RETURN
            _t & "models" & _f & "item" & _f & "description"
            & CONCATENATEX(_models, _r & [@item] & _q & [@code] & _f & [@description], "")
            & _t & "smtables" & _f & "item" & _f & "table" & _f & "ordinal" & _f & "description" & _f & "mode" & _f & "access"
            & CONCATENATEX(_tables, _r & [@item] & _q & [@code] & _f & [@table] & _f & [@ordinal] & _f & [@description] & _f & [@mode] & _f & [@access], "")
            & _t & "smcolumns" & _f & "item" & _f & "table" & _f & "column" & _f & "description" & _f & "datatype" & _f & "columntype" & _f & "sourcecolumn" & _f & "expression"
            & CONCATENATEX(
                _columns,
                _r & [@item] & _q & [@code] & _f & [@table] & _f & [@column] & _f & [@description]
                    & _f & [@datatype] & _f & [@columntype] & _f & [@sourcecolumn] & _f & [@expression],
                ""
            )
            & _t & "smmeasures" & _f & "item" & _f & "table" & _f & "measure" & _f & "description" & _f & "expression" & _f & "format"
            & CONCATENATEX(
                _measures,
                _r & [@item] & _q & [@code] & _f & [@table] & _f & [@measure] & _f & [@description] & _f & [@expression] & _f & [@format],
                ""
            )
            & _t & "smrelationships" & _f & "item" & _f & "name" & _f & "fromtable" & _f & "fromcolumn" & _f & "totable" & _f & "tocolumn" & _f & "fromcardinality" & _f & "tocardinality" & _f & "crossfilter" & _f & "active"
            & CONCATENATEX(
                _relationships,
                _r & [@item] & _q & [@code] & _f & [@name] & _f & [@fromtable] & _f & [@fromcolumn] & _f & [@totable] & _f & [@tocolumn]
                    & _f & [@fromcardinality] & _f & [@tocardinality] & _f & [@crossfilter] & _f & [@active],
                ""
            )
            & _t & "smsources" & _f & "item" & _f & "table" & _f & "reference" & _f & "sourceitem" & _f & "sourceschema" & _f & "sourceobject"
            & CONCATENATEX(
                _sources,
                _r & [@item] & _q & [@code] & _f & [@table] & _f & [@reference]
                    & _f & IF(NOT ISBLANK([@sourceitem]), [@sourceitem] & _q & [@code])
                    & _f & [@sourceschema] & _f & [@sourceobject],
                ""
            )
        ```
        displayFolder: Data

    /// The estate's shape: each item's object count and load state, the
    /// distinct object dependencies between items of one catalogue, and the
    /// physical shortcuts that may land in another catalogue's item.
    measure 'Estate data' = ```
        VAR _f = UNICHAR(57345)
        VAR _r = UNICHAR(57346)
        VAR _t = UNICHAR(57347)
        VAR _q = UNICHAR(57348)
        VAR _nodes = CATALOGUES(
            'Lineage node',
            "@key", 'Lineage node'[Node key],
            "@item", 'Lineage node'[Item label],
            "@internal", 'Lineage node'[Is internal]
        )
        VAR _visible = SELECTCOLUMNS(FILTER(_nodes, NOT [@internal]), "@c", [@catalogue], "@k", [@key])
        VAR _objects = GROUPBY(FILTER(_nodes, NOT [@internal]), [@code], [@item], "@count", SUMX(CURRENTGROUP(), 1))
        VAR _edges = FILTER(
            CATALOGUES(
                'Lineage edge' WHERE 'Lineage edge'[Edge kind] IN {"Dependency", "Shortcut"},
                "@down", 'Lineage edge'[Downstream node key],
                "@from", IF(ISBLANK('Lineage edge'[Through node key]), 'Lineage edge'[Upstream node key], 'Lineage edge'[Through node key]),
                "@downid", 'Lineage edge'[Downstream node ID],
                "@fromid", IF(ISBLANK('Lineage edge'[Through node key]), 'Lineage edge'[Upstream node ID], 'Lineage edge'[Through node ID])
            ),
            (([@catalogue], [@down]) IN _visible) && (([@catalogue], [@from]) IN _visible)
        )
        VAR _between = FILTER(
            DISTINCT(SELECTCOLUMNS(
                _edges,
                "@code", [@code],
                "@down", [@down],
                "@from", [@from],
                "@downitem", LEFT([@downid], FIND("/", [@downid] & "//", FIND("/", [@downid] & "/") + 1) - 1),
                "@fromitem", LEFT([@fromid], FIND("/", [@fromid] & "//", FIND("/", [@fromid] & "/") + 1) - 1)
            )),
            [@downitem] <> [@fromitem]
        )
        VAR _itemedges = GROUPBY(_between, [@code], [@fromitem], [@downitem], "@count", SUMX(CURRENTGROUP(), 1))
        VAR _loads = GROUPBY(
            CATALOGUES(
                'Load status',
                "@item", 'Load status'[Item type] & "/" & 'Load status'[Item name],
                "@failed", IF('Load status'[Result] IN {"Failed", "Error", "Blocked"}, 1, 0),
                "@pending", IF('Load status'[Result] = "Pending", 1, 0)
            ),
            [@code], [@item],
            "@loads", SUMX(CURRENTGROUP(), 1),
            "@lfailed", SUMX(CURRENTGROUP(), [@failed]),
            "@lpending", SUMX(CURRENTGROUP(), [@pending])
        )
        VAR _tests = GROUPBY(
            CATALOGUES(
                'Test status',
                "@item", 'Test status'[Item type] & "/" & 'Test status'[Item name],
                "@failed", IF('Test status'[Result] IN {"Failed", "Error", "Blocked"}, 1, 0)
            ),
            [@code], [@item],
            "@tests", SUMX(CURRENTGROUP(), 1),
            "@tfailed", SUMX(CURRENTGROUP(), [@failed])
        )
        VAR _shortcuts = CATALOGUES(
            'Shortcut' WHERE 'Shortcut'[Target type] = "Physical" && 'Shortcut'[Schema name] <> "_" && 'Shortcut'[Schema name] <> "Tables/_",
            "@item", 'Shortcut'[Item type] & "/" & 'Shortcut'[Item name],
            "@schema", 'Shortcut'[Schema name],
            "@object", 'Shortcut'[Object name],
            "@type", 'Shortcut'[Shortcut type],
            "@workspace", 'Shortcut'[Target workspace name],
            "@targettype", 'Shortcut'[Target item type],
            "@target", 'Shortcut'[Target item name],
            "@targetschema", 'Shortcut'[Target schema name],
            "@targetobject", 'Shortcut'[Target object name]
        )
        RETURN
            _t & "itemobjects" & _f & "item" & _f & "objects"
            & CONCATENATEX(_objects, _r & [@item] & _q & [@code] & _f & [@count], "")
            & _t & "itemedges" & _f & "up" & _f & "down" & _f & "count"
            & CONCATENATEX(_itemedges, _r & [@fromitem] & _q & [@code] & _f & [@downitem] & _q & [@code] & _f & [@count], "")
            & _t & "itemloads" & _f & "item" & _f & "loads" & _f & "failed" & _f & "pending"
            & CONCATENATEX(_loads, _r & [@item] & _q & [@code] & _f & [@loads] & _f & [@lfailed] & _f & [@lpending], "")
            & _t & "itemtests" & _f & "item" & _f & "tests" & _f & "failed"
            & CONCATENATEX(_tests, _r & [@item] & _q & [@code] & _f & [@tests] & _f & [@tfailed], "")
            & _t & "shortcuts" & _f & "item" & _f & "schema" & _f & "object" & _f & "type" & _f & "workspace" & _f & "targettype" & _f & "target" & _f & "targetschema" & _f & "targetobject"
            & CONCATENATEX(
                _shortcuts,
                _r & [@item] & _q & [@code]
                    & _f & [@schema] & _f & [@object] & _f & [@type]
                    & _f & [@workspace] & _f & [@targettype] & _f & [@target]
                    & _f & [@targetschema] & _f & [@targetobject],
                ""
            )
        ```
        displayFolder: Data

    /// The Dashboard's stylesheet and script.
    measure 'Renderer' = ```
        "{renderer}"
        ```
        displayFolder: Pages
        isHidden

    /// The Overview page for HTML Content.
    measure 'Overview page' = PAGE("overview", [Catalogue data] & [Lineage data] & [Status data] & [Workflow data] & [Build data])
        displayFolder: Pages

    /// The Health page for HTML Content.
    measure 'Health page' = PAGE("health", [Catalogue data] & [Lineage data] & [Status data] & [Workflow data] & [Build data])
        displayFolder: Pages

    /// The Orchestration page for HTML Content.
    measure 'Orchestration page' = PAGE("orchestration", [Catalogue data] & [Lineage data] & [Status data] & [Workflow data])
        displayFolder: Pages

    /// The Performance page for HTML Content.
    measure 'Performance page' = PAGE("performance", [Catalogue data] & [Node data] & [Run data] & [Statistic data])
        displayFolder: Pages

    /// The Gantt page for HTML Content.
    measure 'Gantt page' = PAGE("gantt", [Catalogue data] & [Node data] & [Workflow data] & [Log data])
        displayFolder: Pages

    /// The Entity dictionary page for HTML Content.
    measure 'Entity dictionary page' = PAGE("entities", [Catalogue data] & [Lineage data] & [Metadata data])
        displayFolder: Pages

    /// The Semantic model page for HTML Content.
    measure 'Semantic model page' = PAGE("semantic", [Catalogue data] & [Lineage data] & [Status data] & [Semantic data])
        displayFolder: Pages

    /// The Estate page for HTML Content.
    measure 'Estate page' = PAGE("estate", [Catalogue data] & [Estate data])
        displayFolder: Pages
