{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "gantt",
  "displayName": "Gantt",
  "displayOption": "FitToPage",
  "height": 1080,
  "width": 1920,
  "objects": {
    "pageRefresh": [
      {
        "properties": {
          "show": {
            "expr": {
              "Literal": {
                "Value": "true"
              }
            }
          },
          "duration": {
            "expr": {
              "Literal": {
                "Value": "'PT30S'"
              }
            }
          }
        }
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "scopeWorkspace",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Scope"
              }
            },
            "Property": "Workspace"
          }
        },
        "type": "Categorical"
      },
      {
        "name": "scopeItemtype",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Scope"
              }
            },
            "Property": "Item type"
          }
        },
        "type": "Categorical"
      },
      {
        "name": "scopeItemname",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Scope"
              }
            },
            "Property": "Item name"
          }
        },
        "type": "Categorical"
      },
      {
        "name": "scopeObjecttype",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Scope"
              }
            },
            "Property": "Object type"
          }
        },
        "type": "Categorical"
      },
      {
        "name": "scopeObjectname",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Scope"
              }
            },
            "Property": "Object name"
          }
        },
        "type": "Categorical"
      }
    ]
  }
}
